# Every setting the app reads from the environment is listed here: set where a
# value is needed, commented out (showing the default) where it is optional.
# tests/Unit/EnvExampleTest.php fails when a setting read in config/ is missing.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
# generate with: php artisan key:generate
APP_KEY=
APP_URL=your-domain-url
# Base URL for links in transactional email; leave unset to use APP_URL.
# Only set this when a separate frontend origin (SPA) handles those links.
#FRONTEND_URL=
#ALLOWED_FRONTEND_URLS=
APP_NAME="Event Repo"
APP_TAGLINE="Event Repository"
APP_FEEDBACK_EMAIL=your-feedback-email-address
APP_NOREPLY_EMAIL=noreply@yourdomain.com
APP_ADMIN_EMAIL=admin@yourdomain.com
# id of the user treated as the site owner
APP_SUPERUSER=1
# Hashtag added to social posts (optional)
# APP_DEFAULT_HASHTAG=
# Comma-separated venue names whose events are left out of the sitemap (optional)
# SPIDER_BLACKLIST=
PASSWORD_RESET_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33306
DB_DATABASE=event-repo-db-name
DB_USERNAME=root
DB_PASSWORD=db-password
# DB_SOCKET=
# SQLite only (used by static analysis in CI)
# DB_FOREIGN_KEYS=true

# ---------------------------------------------------------------------------
# Cache, sessions, queue
# ---------------------------------------------------------------------------
CACHE_DRIVER=file
SESSION_DRIVER=file
# Minutes of inactivity before a session ends (default 120)
# SESSION_LIFETIME=120
# Set to true on any site served over HTTPS, so the session cookie is never sent over HTTP
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=
# Default: the app name, slugged, plus "_session"
# SESSION_COOKIE=
# Only for the database / redis / cache session drivers
# SESSION_CONNECTION=
# SESSION_STORE=

# Must be "database" in production, with a worker running (docs/deployment_notes.md).
# Left unset it falls back to "sync", which runs Instagram and Discord posts
# inside the web request that triggered them.
QUEUE_DRIVER=database
# Also email users when one of their queued jobs finishes
QUEUE_NOTIFY_EMAIL=false

# Redis is not required; only read if a cache, session or queue driver is set to redis.
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

# ---------------------------------------------------------------------------
# Files and images
# ---------------------------------------------------------------------------
# Default disk for general file storage: "local" or "s3"
# FILESYSTEM_DRIVER=local
# FILESYSTEM_CLOUD=s3

# Photos and flyers are stored on the "external" disk, a DigitalOcean Space
# (or any S3-compatible bucket). Uploads fail without these.
DIGITALOCEAN_SPACES_KEY=
DIGITALOCEAN_SPACES_SECRET=
# e.g. https://nyc3.digitaloceanspaces.com
DIGITALOCEAN_SPACES_ENDPOINT=
DIGITALOCEAN_SPACES_REGION=
DIGITALOCEAN_SPACES_BUCKET=
# Folder inside the bucket (optional)
# DIGITALOCEAN_SPACES_ROOT=
# Base of public file URLs: the CDN endpoint or a custom domain. Left unset,
# the bucket's own host under the endpoint is used.
# DIGITALOCEAN_SPACES_URL=

# Only for the plain "s3" disk
# AWS_BUCKET=
# AWS_URL=

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Which mailer config/mail.php resolves. "log" writes mail to the log and sends
# nothing, which is what a new install wants until a real mailer is set up.
# "ses" for Amazon SES, "smtp" for a plain SMTP relay, "mailgun" for the
# Mailgun API, "array" to discard mail.
# MAIL_DRIVER is still read as a fallback for older environment files.
MAIL_MAILER=log
# MAIL_DRIVER=

# Amazon SES. The region must be the one the sending identity is verified in —
# there is no fallback, so a missing value fails loudly rather than sending to
# the wrong region and reporting it as an unverified address.
AWS_ACCESS_KEY_ID=your-ses-access-key-id
AWS_SECRET_ACCESS_KEY=your-ses-secret-access-key
AWS_DEFAULT_REGION=us-east-2
# Optional. Names the SES configuration set that publishes bounce and
# complaint events to SNS. Omit it and no configuration set is sent.
SES_CONFIGURATION_SET=
# Comma-separated SNS topic ARNs the bounce/complaint webhook accepts.
# Left empty, the webhook rejects every notification.
# SES_SNS_TOPIC_ARNS=

# Only read when MAIL_MAILER=smtp. Port 465 selects implicit TLS, anything
# else uses STARTTLS; set MAIL_SCHEME only to force it.
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@yourdomain.com
MAIL_PASSWORD=your-mail-password
# MAIL_SCHEME=

# Only read when MAIL_MAILER=mailgun
# MAIL_DOMAIN=
# MAIL_SECRET=

# Only read when MAIL_MAILER=log: the log channel to write mail to
# MAIL_LOG_CHANNEL=

# ---------------------------------------------------------------------------
# Signup protection
# ---------------------------------------------------------------------------
# Google reCAPTCHA v2. Registration requires a solved captcha, so nobody can
# sign up until both are set. (Read by the anhskohbo/no-captcha package.)
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

# spam signup lookup (#2312); sends an email hash and the signup IP to stopforumspam.org
STOPFORUMSPAM_ENABLED=false

# ---------------------------------------------------------------------------
# API and browser security
# ---------------------------------------------------------------------------
# Sanctum personal access token lifetime, in minutes (default: 30 days). Leave blank for non-expiring tokens.
SANCTUM_TOKEN_EXPIRATION=43200
# Hosts whose browser sessions may call the API with cookies. Default: localhost plus the APP_URL host.
# SANCTUM_STATEFUL_DOMAINS=
# Comma-separated extra CORS origins for non-production environments (optional).
CORS_EXTRA_ORIGINS=
# Content-Security-Policy-Report-Only header (reports to /csp-report); set false to turn it off
CSP_REPORT_ONLY=true

# ---------------------------------------------------------------------------
# Logging and error reporting
# ---------------------------------------------------------------------------
# "stack" writes to the channels in LOG_STACK; "daily" keeps one file per day
# LOG_CHANNEL=stack
# LOG_STACK=daily
# Octal file mode for log files (default 0664, so the web user and the deploying user can both write)
# LOG_PERMISSION=0664
# LOG_SLACK_WEBHOOK_URL=

# Sentry error reporting; leave the DSN blank to turn it off.
# SENTRY_LARAVEL_DSN is read as a fallback name.
SENTRY_DSN=
# SENTRY_LARAVEL_DSN=
# Share of requests traced for performance (default 0.05)
# SENTRY_TRACES_SAMPLE_RATE=0.05
# Share of traced requests that are also profiled (default 1.0)
# SENTRY_PROFILES_SAMPLE_RATE=1.0
# Send query values with errors (off by default; they can hold personal data)
# SENTRY_SQL_BINDINGS=false
# The deployed commit. bin/deploy sets it when it caches the config; don't set it here.
# SENTRY_RELEASE=

# Monitoring (php artisan monitor:check, see docs/deployment_notes.md)
# Minutes a queued job may wait before the queue is reported as not being worked
# MONITOR_QUEUE_MAX_WAIT_MINUTES=45
# Days before the Facebook/Instagram token expires to start reporting it
# MONITOR_TOKEN_WARN_DAYS=14
# Hours before the same problem is reported again
# MONITOR_REPEAT_HOURS=6

# ---------------------------------------------------------------------------
# Facebook and Instagram
# ---------------------------------------------------------------------------
APP_FB_APP_ID=1111111111
FACEBOOK_APP_ID=999
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v5.0
# Read by config but not used anywhere at present
# FACEBOOK_GRAPH_API=
# FACEBOOK_DEFAULT_ACCESS_TOKEN=

# Instagram posting. Without the page token nothing is posted.
# FACEBOOK_SYSTEM_USER_ACCESS_TOKEN=
# FACEBOOK_SYSTEM_PAGE_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# FACEBOOK_IG_USER_ID=
# Comma-separated list of additional handles or hashtags to add to every Instagram post
# Example: @pgh.events,@another.handle,#sometag
INSTAGRAM_ADDITIONAL_HANDLES=

# ---------------------------------------------------------------------------
# Discord auto-repost (issue #2058). Off by default. The per-channel webhook
# URLs are secrets and are NOT set here — they are configured in the admin UI
# at /discord-targets and stored encrypted in the database.
# ---------------------------------------------------------------------------
DISCORD_ENABLED=false
DISCORD_CREATE_DELAY_MINUTES=30
DISCORD_AUTO_DISABLE_AFTER_FAILURES=5
DISCORD_NOTIFY_ADMIN_ON_FAILURE=true
# Seconds to wait for Discord to answer (default 10)
# DISCORD_TIMEOUT=10
# DISCORD_WEBHOOK_USERNAME=
# DISCORD_WEBHOOK_AVATAR_URL=

# ---------------------------------------------------------------------------
# Feedback
# ---------------------------------------------------------------------------
# Proactive feedback interview (issue #1998). Off by default — must be set to
# true in production for invitations to generate or the prompt to display.
FEEDBACK_ENABLED=false
# The post-event invitation campaign, when FEEDBACK_ENABLED is on (default true)
# FEEDBACK_POST_EVENT_ENABLED=true

# ---------------------------------------------------------------------------
# Analytics and social links
# ---------------------------------------------------------------------------
GOOGLE_ANALYTICS=
# Google Tag Manager container id (optional)
# GOOGLE_TAGS=

SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TWITTER=
SOCIAL_GITHUB=

# ---------------------------------------------------------------------------
# AI / LLM configuration (used for flyer analysis)
# ---------------------------------------------------------------------------
# Supported provider: anthropic
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Default: on when APP_DEBUG is true
# DEBUGBAR_ENABLED=
# Password hashing cost (default 10; the test suite uses 4)
# BCRYPT_ROUNDS=10
# Default: storage/framework/views
# VIEW_COMPILED_PATH=
